<Window x:Class="HttpMonitorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="HTTP Monitor" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <TabControl Margin="10">
        <TabItem Header="Сервер">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Порт:" VerticalAlignment="Center" Margin="0,0,5,0"/>

                    <!-- ПОЛЕ ПОРТА С ПОДСКАЗКОЙ -->
                    <TextBox x:Name="PortBox" Width="80" Text="5000" Margin="0,0,5,0">
                        <TextBox.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Margin="0,0,0,5">Допустимые порты:</TextBlock>
                                    <TextBlock>• 1024 – 65535</TextBlock>
                                    <TextBlock Margin="0,5,0,0"><Bold>Рекомендуемые:</Bold></TextBlock>
                                    <TextBlock>• 5000, 8080, 8000</TextBlock>
                                    <TextBlock Margin="0,5,0,0" FontStyle="Italic" Foreground="Gray">
                                        Порты 1-1023 требуют прав администратора
                                    </TextBlock>
                                </StackPanel>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>

                    <Button x:Name="StartBtn" Content="Запустить сервер" Width="120" Margin="0,0,5,0" Click="StartBtn_Click"/>
                    <Button x:Name="StopBtn" Content="Остановить" Width="100" Margin="0,0,10,0" Click="StopBtn_Click" IsEnabled="False"/>
                    <Button Content="Сохранить логи" Width="100" Click="SaveLogsBtn_Click"/>
                </StackPanel>

                <TextBox x:Name="ServerLogBox" Grid.Row="1" IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" 
                         Background="#F5F5F5"/>
            </Grid>
        </TabItem>

        <TabItem Header="Клиент">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="UrlBox" Text="http://localhost:5000/status" Margin="0,0,10,0"/>
                    <ComboBox x:Name="MethodBox" Grid.Column="1" Width="80" SelectedIndex="0" Margin="0,0,10,0">
                        <ComboBoxItem Content="GET"/>
                        <ComboBoxItem Content="POST"/>
                    </ComboBox>
                    <Button x:Name="SendBtn" Grid.Column="2" Content="Отправить запрос" Width="120" Click="SendBtn_Click"/>
                </Grid>

                <TextBox x:Name="BodyBox" Grid.Row="1" Height="100" 
                         Text="{}{&quot;message&quot;:&quot;test&quot;}" 
                         Margin="0,0,0,10" TextWrapping="Wrap" AcceptsReturn="True"/>

                <TextBox x:Name="ResponseBox" Grid.Row="2" IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                         Background="#F0F8FF"/>
            </Grid>
        </TabItem>

        <TabItem Header="Мониторинг">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Всего GET:" FontWeight="Bold"/>
                            <TextBlock x:Name="GetCountText" Text="0" FontSize="16"/>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Всего POST:" FontWeight="Bold"/>
                            <TextBlock x:Name="PostCountText" Text="0" FontSize="16"/>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Среднее время:" FontWeight="Bold"/>
                            <TextBlock x:Name="AvgTimeText" Text="0 ms" FontSize="16"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="Blue" BorderThickness="1" Margin="0,0,0,5">
                        <Grid>
                            <TextBlock Text="GET Запросы" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5" FontWeight="Bold"/>
                            <lvc:CartesianChart x:Name="GetChart" Margin="20,20,5,5"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" BorderBrush="Red" BorderThickness="1" Margin="0,5,0,0">
                        <Grid>
                            <TextBlock Text="POST Запросы" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5" FontWeight="Bold"/>
                            <lvc:CartesianChart x:Name="PostChart" Margin="20,20,5,5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</Window>